# Application
APP_ENV=local
# Empty = listen on all interfaces. Set e.g. 192.168.101.77 to bind one address.
APP_HOST=
APP_PORT=8081

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/propertydb?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# Upload
UPLOAD_PATH=./uploads
DOCUMENT_PATH=./documents

# Logging: JSON lines are also appended to this file when set (optional)
# LOG_FILE=./logs/app.log
DOCUMENT_PATH=./documents
UPLOAD_MAX_SIZE=5242880

# Rate Limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60
# Every /api/v1 request, per IP
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW=60
# Image and document uploads, per IP
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW=60

# CORS (comma-separated origins; empty = no cross-origin browser access)
CORS_ALLOWED_ORIGINS=

# Commission percentage applied to finalized deals (0-100)
COMMISSION_DEFAULT_PERCENTAGE=2.5

# Brute-force protection and sessions
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MAX_ACTIVE_SESSIONS=5

# Reverse proxy (nginx/Caddy) IPs or CIDRs, comma-separated. Leave empty when not behind a proxy.
TRUSTED_PROXIES=
